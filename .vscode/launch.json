{
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Fly-in: lancer",
            "type": "debugpy",
            "request": "launch",
            "program": "fly_in",
            "cwd": "${workspaceFolder}",
            "args": [
                "${input:mapFile}"
            ],
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Fly-in: debugger",
            "type": "debugpy",
            "request": "launch",
            "module": "fly_in",
            "cwd": "${workspaceFolder}",
            "args": [
                "${input:mapFile}"
            ],
            "console": "integratedTerminal",
            "justMyCode": true,
            "stopOnEntry": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Tests: pytest",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "cwd": "${workspaceFolder}",
            "args": [
                "-q"
            ],
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        }
    ],
    "inputs": [
        {
            "id": "mapFile",
            "type": "promptString",
            "description": "Chemin vers le fichier de carte",
            "default": "maps/example.map"
        }
    ]
}
